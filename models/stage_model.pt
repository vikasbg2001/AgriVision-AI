from ultralytics import YOLO


def main():

    model = YOLO("yolov8n.pt")

    model.train(
        data="datasets/stage/data.yaml",
        epochs=100,
        imgsz=640,
        batch=16,
        project="runs",
        name="stage_model"
    )

    print("Training Completed")


if __name__ == "__main__":
    main()
