from ultralytics import YOLO

def main():
    # Load a pretrained YOLOv8 model
    model = YOLO("yolov8n.pt")

    # Train on your disease dataset
    model.train(
        data="datasets/disease/data.yaml",
        epochs=100,
        imgsz=640,
        batch=16,
        project="runs",
        name="disease_model"
    )

    print("Disease model training completed.")

if __name__ == "__main__":
    main()
